# API environment variables — copy to .env and adjust.

NODE_ENV=development
PORT=4000

# ============================================================================
# MongoDB Configuration
# ============================================================================
# Choose ONE: MongoDB Compass (local) OR MongoDB Atlas (cloud).
# The app will use MONGODB_URI if set; otherwise it falls back to the local
# Compass default defined below.

# --------------------------------------------------------------------------
# Option A: MongoDB Compass (local / self-hosted)
# --------------------------------------------------------------------------
# Default connection to a local MongoDB instance started via mongod or Compass.
# Ensure your local MongoDB is running before starting the API.
MONGODB_URI=mongodb://localhost:27017/workforce_management

# If your local instance requires authentication, uncomment and configure:
# MONGODB_URI=mongodb://<USERNAME>:<PASSWORD>@localhost:27017/workforce_management?authSource=admin

# --------------------------------------------------------------------------
# Option B: MongoDB Atlas (cloud)
# --------------------------------------------------------------------------
# 1. Create a cluster at https://www.mongodb.com/atlas/database
# 2. Get your connection string (Select "Connect your application" → Node.js)
# 3. Replace <USERNAME>, <PASSWORD>, and <CLUSTER_URL> with your values.
# 4. Whitelist your IP in Atlas Network Access or use 0.0.0.0/0 for testing.
#
# MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER_URL>/workforce_management?retryWrites=true&w=majority

# --------------------------------------------------------------------------
# Connection tuning (optional, both Compass and Atlas)
# --------------------------------------------------------------------------
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=50

# ============================================================================
# JWT
# ============================================================================
JWT_ACCESS_SECRET=replace-with-strong-random-string
JWT_REFRESH_SECRET=replace-with-strong-random-string
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================================
# CORS
# ============================================================================
CORS_ORIGIN=http://localhost:4200

# ============================================================================
# Rate limiting
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ============================================================================
# Password reset
# ============================================================================
PASSWORD_RESET_TOKEN_EXPIRES_IN_MIN=15

# ============================================================================
# Email (Nodemailer)
# ============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Workforce Management <no-reply@company.com>"

# ============================================================================
# Defaults
# ============================================================================
DEFAULT_GRACE_PERIOD_MINUTES=15
DEFAULT_OFFICE_RADIUS_METERS=100
DEFAULT_TIMEZONE=Asia/Dhaka
